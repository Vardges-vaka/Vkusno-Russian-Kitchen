{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.vkusno.ae" }],
      "destination": "https://vkusno.ae/:path*",
      "permanent": true
    },
    {
      "source": "/elementor-236",
      "destination": "/en/menu",
      "permanent": true
    },
    {
      "source": "/menu",
      "destination": "/en/menu",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/en/contact",
      "permanent": true
    },
    {
      "source": "/hello-world",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/en/contact",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/en/faq",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/en/privacy",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/:lang(en|ru|ar)/index.html",
      "destination": "/:lang",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/feed/:path*",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/category",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/category/:path*",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/author",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/author/:path*",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "p" }],
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/wp-:path*",
      "destination": "/en",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|locales/)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "live.vkusno.ae"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.live.vkusno.ae"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/locales/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
